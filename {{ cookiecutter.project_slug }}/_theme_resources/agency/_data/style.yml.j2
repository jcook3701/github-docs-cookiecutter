---
# Agency theme color and typography defaults.
highlight: "#0d6efd"
white: "#ffffff"
black: "#111827"

fonts_urls:
  - "https://fonts.googleapis.com/css?family=Montserrat:400,700"
  - "https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700"
  - "https://fonts.googleapis.com/css?family=Kaushan+Script"

fonts:
  - name: "Montserrat"
    for: "heading"
  - name: "Kaushan Script"
    for: "script"
  - name: "Roboto Slab"
    for: "body"
