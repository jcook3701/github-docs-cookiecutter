{#-
  Central Cookiecutter context for all generated Jekyll projects.

  Import this module with context. Keep input normalization, serialization,
  site-type behavior, and theme capabilities here so generated templates do
  not need their own copies of those decisions.
-#}

{% set inputs = cookiecutter %}

{# -------------------------------------------------------------------------- #}
{# Format-specific serialization. Raw values remain available through values. #}
{# -------------------------------------------------------------------------- #}
{% macro yaml_string(value) -%}
{{- value | tojson
    | replace('\\u0027', "'")
    | replace('\\u003c', '<')
    | replace('\\u003e', '>')
    | replace('\\u0026', '&') -}}
{%- endmacro %}

{% macro html_string(value) -%}
{{- value | string | e -}}
{%- endmacro %}

{% macro markdown_string(value) -%}
{{- value | string
    | replace('\\', '\\\\')
    | replace('`', '\\`')
    | replace('*', '\\*')
    | replace('_', '\\_')
    | replace('[', '\\[')
    | replace(']', '\\]')
    | replace('<', '\\<')
    | replace('>', '\\>') -}}
{%- endmacro %}

{% macro make_shell_string(value) -%}
'{{- value | string | replace('$', '$$') | replace("'", "'\"'\"'") -}}'
{%- endmacro %}

{# -------------------------------------------------------------------------- #}
{# GitHub identity, Pages routing, and public-facing project metadata.        #}
{# -------------------------------------------------------------------------- #}
{% set github_owner = inputs.github_org or inputs.github_username %}
{% set repository = github_owner ~ '/' ~ inputs.project_slug %}
{% set repo_url = 'https://github.com/' ~ repository %}
{% set custom_domain = (inputs.custom_domain | default('', true) | trim) %}
{% if custom_domain %}
  {# GitHub Pages custom domains are hostnames, never URL subpaths or ports. #}
  {% set domain_without_scheme = custom_domain.split('://', 1)[1]
    if '://' in custom_domain else custom_domain %}
  {% set domain_authority = domain_without_scheme.lstrip('/').split('/', 1)[0]
    .split('?', 1)[0].split('#', 1)[0] %}
  {% set custom_domain_hostname = domain_authority.split(':', 1)[0]
    .rstrip('.').lower() %}
  {% set site_url = 'https://' ~ custom_domain_hostname %}
  {% set baseurl = '' %}
{% else %}
  {% set custom_domain_hostname = '' %}
  {% set site_url = 'https://' ~ github_owner ~ '.github.io' %}
  {% set baseurl = '/' ~ inputs.project_slug if inputs.pages_site_type == 'project' else '' %}
{% endif %}

