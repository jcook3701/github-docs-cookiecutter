{% set selected_theme = inputs.theme %}
{% set normalized_theme_key = theme_aliases.get(selected_theme, selected_theme) %}
{% set theme = themes[normalized_theme_key] %}
{% set selected_site_type = site_types[inputs.site_type] %}
{% set theme_supported = theme.supported %}
{% set site_type_supported = inputs.site_type in theme.site_types %}
{% set selection_supported = theme_supported and site_type_supported %}
{% if not theme_supported %}
  {% set support_message = theme.support_note %}
{% elif not site_type_supported %}
  {% set support_message = theme.label ~ ' supports ' ~ (theme.site_types | join(', ')) ~ ' sites, not ' ~ inputs.site_type ~ '.' %}
{% else %}
  {% set support_message = theme.support_note %}
{% endif %}
{% set normalized_theme = theme.remote_theme or normalized_theme_key %}

{% set company = inputs.company or '' %}
{% set site_title = company if inputs.site_type == 'company' and company else inputs.project_name %}
{% set seo_title = (site_title ~ ' Documentation') if inputs.site_type == 'documentation' else site_title %}

{# Keep data types intact here; serialization belongs in yaml/html/markdown. #}
{% set values = {
  'project_name': inputs.project_name, 'project_slug': inputs.project_slug,
  'company': company, 'title': site_title, 'seo_title': seo_title,
  'author': inputs.author, 'email': inputs.email,
  'formspree_form_path': inputs.formspree_form_path,
  'version': inputs.version,
  'license': inputs.license, 'copyright': inputs.copyright, 'timezone': inputs.timezone,
  'description': inputs.description, 'site_type': inputs.site_type,
  'pages_site_type': inputs.pages_site_type, 'template_type': inputs.template_type,
  'publication_year': inputs.publication_year, 'current_year': inputs.current_year,
  'year_range': inputs.__year_range, 'contribution_model': inputs.contribution_model,
  'github_org': inputs.github_org or '', 'github_username': inputs.github_username,
  'github_owner': github_owner, 'repository': repository, 'repo_url': repo_url,
  'github_profile_url': 'https://github.com/' ~ github_owner,
  'repo_blob': repo_url ~ '/blob/' ~ inputs._default_branch,
  'license_url': repo_url ~ '/blob/' ~ inputs._default_branch ~ '/LICENSE.md',
  'github_aux_label': inputs.project_name ~ ' on GitHub',
  'github_io_url': site_url ~ baseurl, 'github_io': inputs.github_io,
  'url': site_url, 'baseurl': baseurl, 'custom_domain': custom_domain,
  'custom_domain_hostname': custom_domain_hostname,
  'default_branch': inputs._default_branch, 'ga_tracking': inputs.ga_tracking,
  'twitter_username': inputs.twitter_username,
  'linkedin_usercode': inputs.linkedin_usercode,
  'buymeacoffee_username': inputs.buymeacoffee_username,
  'theme': selected_theme, 'normalized_theme': normalized_theme,
  'is_sub_template': inputs._is_sub_template
} %}

{% set yaml = {} %}
{% set html = {} %}
{% set markdown = {} %}
{% set make_shell = {} %}
{% for key, value in values.items() %}
  {% do yaml.update({key: yaml_string(value)}) %}
  {% do html.update({key: html_string(value)}) %}
  {% do markdown.update({key: markdown_string(value)}) %}
  {% do make_shell.update({key: make_shell_string(value)}) %}
{% endfor %}

{# -------------------------------------------------------------------------- #}
{# Dependencies and plugins are structured, versionable, and de-duplicated.  #}
{# -------------------------------------------------------------------------- #}
{% set core_gems = [
  {'name': 'faraday', 'version': '~> 2.14'},
  {'name': 'faraday-retry', 'version': '~> 2.3'},
  {'name': 'bigdecimal', 'version': none},
  {'name': 'csv', 'version': none},
  {'name': 'logger', 'version': none},
  {'name': 'base64', 'version': none},
  {'name': 'webrick', 'version': none}
] %}
{% set base_plugins = [
  {'name': 'jekyll-redirect-from', 'version': '~> 0.16'},
  {'name': 'jekyll-seo-tag', 'version': '~> 2.8'},
  {'name': 'jekyll-github-metadata', 'version': '~> 2.16'},
  {'name': 'jekyll-include-cache', 'version': '~> 0.2'},
  {'name': 'jekyll-sitemap', 'version': '~> 1.4'}
] %}
{% set remote_theme_plugin = {'name': 'jekyll-remote-theme', 'version': '~> 0.4'} %}

{% set runtime_gems = [] %}
{% set runtime_gem_names = [] %}
{% set runtime_candidates = core_gems + (theme.gems if selection_supported else []) %}
{% for dependency in runtime_candidates %}
  {% if dependency.name not in runtime_gem_names %}
    {% do runtime_gems.append(dependency) %}
    {% do runtime_gem_names.append(dependency.name) %}
  {% endif %}
{% endfor %}

{% set theme_plugins = theme.plugins + theme.get('site_plugins', {}).get(values.site_type, []) %}
{% set plugin_candidates = base_plugins + (theme_plugins if selection_supported else []) %}
{% if selection_supported and theme.integration == 'remote_theme' %}
  {% set plugin_candidates = plugin_candidates + [remote_theme_plugin] %}
{% endif %}
{% set plugins = [] %}
{% set plugin_names = [] %}
{% for plugin in plugin_candidates %}
  {% if plugin.name not in plugin_names and plugin.name not in runtime_gem_names %}
    {% do plugins.append(plugin) %}
    {% do plugin_names.append(plugin.name) %}
  {% endif %}
{% endfor %}

{% set collections = {} %}
{% do collections.update(selected_site_type.collections) %}
{% if selection_supported %}
  {% do collections.update(theme.collections) %}
{% endif %}

{% set selected_resource_packs = [] %}
{% if selected_site_type.resource_pack %}
  {% do selected_resource_packs.append(selected_site_type.resource_pack) %}
{% endif %}
{% if selection_supported and theme.resource_pack %}
  {% do selected_resource_packs.append(theme.resource_pack) %}
{% endif %}

{% set homepage_template = selected_site_type.homepage_template %}
{% set homepage_layout = theme.get('home_layouts', {}).get(
  values.site_type, theme.get('home_layout', theme.page_layout)
) if selection_supported else 'default' %}
{% set homepage_mode = theme.get('homepage_mode', 'content') if selection_supported else 'content' %}
