# Minimal Mistakes
minimal_mistakes_skin: default
locale: en-US
search: true
breadcrumbs: true
{% if cfg.values.site_type != 'blog' %}
atom_feed:
  hide: true
{% endif %}
defaults:
  - scope:
      path: ""
      type: posts
    values:
      layout: single
  - scope:
      path: ""
      type: pages
    values:
      layout: single
